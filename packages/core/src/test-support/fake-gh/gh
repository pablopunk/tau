#!/usr/bin/env node
"use strict";
const { appendFileSync, readFileSync } = require("node:fs");

const STATUS = ["auth", "status", "--hostname", "github.com", "--active", "--json", "hosts"];
const REPOS = [
  "api",
  "--hostname",
  "github.com",
  "user/repos?sort=pushed&per_page=100&affiliation=owner,collaborator,organization_member",
  "--jq",
  "[.[] | select((.archived or .disabled)|not) | {full_name, private, pushed_at, clone_url, ssh_url, description}]",
];

const sameArgs = (expected) => expected.length === process.argv.length - 2 && expected.every((arg, i) => arg === process.argv[i + 2]);
const config = JSON.parse(readFileSync(process.env.FAKE_GH_CONFIG, "utf8"));
if (process.env.FAKE_GH_LOG) appendFileSync(process.env.FAKE_GH_LOG, `${JSON.stringify(process.argv.slice(2))}\n`);

const host = (status) => ({ state: "success", active: true, host: "github.com", login: status.login, tokenSource: status.tokenSource, scopes: "repo", gitProtocol: status.gitProtocol });

function answerStatus(status) {
  if (status.state === "connected") return console.log(JSON.stringify({ hosts: { "github.com": [host(status)] } }));
  if (status.state === "not_logged_in") return console.log(JSON.stringify({ hosts: {} }));
  console.error(status.message || "fake gh failure");
  process.exitCode = 1;
}

if (sameArgs(STATUS)) answerStatus(config.status);
else if (sameArgs(REPOS)) console.log(JSON.stringify(config.repos));
else {
  console.error("fake gh: unexpected arguments");
  process.exitCode = 2;
}
