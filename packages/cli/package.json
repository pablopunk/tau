{
  "name": "tau",
  "version": "0.0.0",
  "description": "Chat with a coding agent that works in your project folders, from the browser.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tau": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@earendil-works/pi-env": "1.3.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.6",
    "@fastify/type-provider-typebox": "6.3.0",
    "@fastify/websocket": "11.3.4",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.7",
    "open": "11.0.4",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@tau/core": "workspace:*",
    "@tau/protocol": "workspace:*",
