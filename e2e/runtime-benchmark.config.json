{
  "deterministicOverheadOnly": true,
  "fixtureRepo": { "directories": 10, "files": 200, "bytesPerFile": 2048 },
  "executors": ["pi", "claude-code"],
  "samples": 20,
  "warmup": 2,
  "concurrency": [1, 4],
  "sampleTimeoutMs": 30000,
  "rawSampleLimit": 100,
  "idleCpuWindowMs": 1000,
  "budgets": {
    "label": "TARGETS: proposed regression gates, not measured facts. A FAIL means a run missed the target, a PASS only means it met it on this machine.",
    "targets": [
      {
        "id": "pi-receipt-p95-c1",
        "description": "Pi submit to receipt p95, one start",
        "kind": "stage-percentile",
        "executor": "pi",
        "concurrency": 1,
        "stage": "submitToReceipt",
        "percentile": "p95",
        "maxMs": 100
      },
      {
        "id": "pi-receipt-p95-c4",
        "description": "Pi submit to receipt p95, four simultaneous starts",
        "kind": "stage-percentile",
        "executor": "pi",
        "concurrency": 4,
        "stage": "submitToReceipt",
        "percentile": "p95",
        "maxMs": 100
      },
      {
        "id": "native-receipt-p95-c1",
        "description": "Native submit to receipt p95 (admission returns; preparation is a separate stage), one start",
        "kind": "stage-percentile",
        "executor": "claude-code",
        "concurrency": 1,
        "stage": "submitToReceipt",
        "percentile": "p95",
        "maxMs": 100
      },
      {
        "id": "native-receipt-p95-c4",
        "description": "Native submit to receipt p95 (admission returns; preparation is a separate stage), four simultaneous starts",
        "kind": "stage-percentile",
        "executor": "claude-code",
        "concurrency": 4,
        "stage": "submitToReceipt",
        "percentile": "p95",
        "maxMs": 100
      },
      {
        "id": "native-preparation-p95-c1",
        "description": "Native receipt to SDK query seam p95, one start",
        "kind": "stage-percentile",
        "executor": "claude-code",
        "concurrency": 1,
        "stage": "preparation",
        "percentile": "p95",
        "maxMs": 500
      },
      {
        "id": "native-launch-first-event-p95-c1",
        "description": "Native SDK query to first message p95 (includes sandbox-exec spawn), one start",
        "kind": "stage-percentile",
        "executor": "claude-code",
        "concurrency": 1,
        "stage": "launchToFirstEvent",
        "percentile": "p95",
        "maxMs": 3000
      },
      {
        "id": "pi-idle-cpu-delta",
        "description": "Pi: this process's idle CPU after the runs minus before, in percentage points of one core",
        "kind": "idle-cpu-delta",
        "executor": "pi",
        "maxPercentagePoints": 2
      },
      {
        "id": "native-idle-cpu-delta",
        "description": "Native: this process's idle CPU after the runs minus before, in percentage points of one core",
        "kind": "idle-cpu-delta",
        "executor": "claude-code",
        "maxPercentagePoints": 2
      },
      {
        "id": "native-no-leftover-processes",
        "description": "Native: no owned child or new descendant process alive after the runs",
        "kind": "no-leftover-processes",
        "executor": "claude-code"
      },
      {
        "id": "pi-no-leftover-processes",
        "description": "Pi: no new descendant process alive after the runs",
        "kind": "no-leftover-processes",
        "executor": "pi"
      },
      {
        "id": "pi-no-errors",
        "description": "Pi: every sample completed with every stage recorded",
        "kind": "no-errors",
        "executor": "pi"
      },
      {
        "id": "native-no-errors",
        "description": "Native: every sample completed with every stage recorded",
        "kind": "no-errors",
        "executor": "claude-code"
      }
    ]
  }
}
