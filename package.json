{
  "name": "tau-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "check": "biome check . && pnpm -r --workspace-concurrency=1 typecheck",
    "format": "biome check --write .",
    "test": "pnpm -r --filter '!@tau/e2e' test",
    "build": "pnpm -r --filter '!@tau/e2e' build",
    "fixtures": "pnpm --filter @tau/core fixtures",
    "e2e": "pnpm --filter @tau/e2e test",
    "screenshots": "pnpm --filter @tau/e2e screenshots",
    "build:binary": "tsx scripts/build-binary.ts",
    "smoke:binary": "tsx scripts/smoke-binary.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
